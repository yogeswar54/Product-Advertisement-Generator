# APP_ENV=local: Purpose runtime mode; default local; allowed local/demo/live.
APP_ENV=local
# API_HOST=127.0.0.1: Purpose local API bind host; default 127.0.0.1.
API_HOST=127.0.0.1
# API_PORT=8000: Purpose host API port; default 8000.
API_PORT=8000
# FRONTEND_HOST=127.0.0.1: Purpose local UI bind host; default 127.0.0.1.
FRONTEND_HOST=127.0.0.1
# FRONTEND_PORT=8501: Purpose host UI port; default 8501.
FRONTEND_PORT=8501
# ALLOWED_CORS_ORIGINS: Purpose permitted browser origins; default local Streamlit origins.
ALLOWED_CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
# API_BASE_URL: Purpose frontend-to-API URL; default local API; Compose overrides to backend DNS.
API_BASE_URL=http://127.0.0.1:8000

# CAMPAIGN_DATABASE_URL: Purpose SQLAlchemy URL; default local SQLite.
CAMPAIGN_DATABASE_URL=sqlite:///storage/campaigns.db

# MAX_PRODUCT_IMAGE_BYTES=10485760: Purpose upload ceiling; default 10 MiB.
MAX_PRODUCT_IMAGE_BYTES=10485760

# LLM_PROVIDER: Purpose provider selection; default mock; allowed mock/hosted.
LLM_PROVIDER=mock
# LLM_API_KEY: Purpose hosted provider authentication; secret; default empty.
LLM_API_KEY=
# LLM_BASE_URL: Purpose hosted provider endpoint; default OpenAI-compatible URL.
LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL: Purpose hosted model name; default configured-model placeholder.
LLM_MODEL=configured-model
# LLM_TIMEOUT_SECONDS: Purpose request timeout; default 30 seconds.
LLM_TIMEOUT_SECONDS=30
# TOKEN_BUDGET_ESTIMATE_PER_CAMPAIGN: Purpose estimated token cap; default 2500.
TOKEN_BUDGET_ESTIMATE_PER_CAMPAIGN=2500

# IMAGE_PROVIDER: Purpose provider selection; default mock; allowed mock/hosted.
IMAGE_PROVIDER=mock
# IMAGE_API_KEY: Purpose hosted image provider authentication; secret; default empty.
IMAGE_API_KEY=
# IMAGE_API_BASE_URL: Purpose hosted image endpoint; default placeholder URL.
IMAGE_API_BASE_URL=https://api.example.invalid/v1
# IMAGE_MODEL: Purpose hosted model name; default configured-image-model placeholder.
IMAGE_MODEL=configured-image-model
# IMAGE_TIMEOUT_SECONDS: Purpose request timeout; default 60 seconds.
IMAGE_TIMEOUT_SECONDS=60
# IMAGE_LIMIT_PER_REQUEST: Purpose image generations per request; default 1.
IMAGE_LIMIT_PER_REQUEST=1
# IMAGE_LIMIT_PER_CAMPAIGN: Purpose image generations per campaign; default 4.
IMAGE_LIMIT_PER_CAMPAIGN=4

# TTS_PROVIDER: Purpose provider selection; default mock; allowed mock/hosted.
TTS_PROVIDER=mock
# TTS_API_KEY: Purpose hosted TTS authentication; secret; default empty.
TTS_API_KEY=
# TTS_API_BASE_URL: Purpose hosted TTS endpoint; default placeholder URL.
TTS_API_BASE_URL=https://api.example.invalid/v1
# TTS_MODEL: Purpose hosted model name; default configured-tts-model placeholder.
TTS_MODEL=configured-tts-model
# TTS_TIMEOUT_SECONDS: Purpose request timeout; default 30 seconds.
TTS_TIMEOUT_SECONDS=30
# TTS_LIMIT_PER_REQUEST: Purpose TTS calls per request; default 1.
TTS_LIMIT_PER_REQUEST=1
# TTS_LIMIT_PER_CAMPAIGN: Purpose TTS calls per campaign; default 6.
TTS_LIMIT_PER_CAMPAIGN=6

# VIDEO_MAX_SECONDS: Purpose maximum script duration; default 60 seconds.
VIDEO_MAX_SECONDS=60
# VIDEO_BUILD_LIMIT_PER_CAMPAIGN: Purpose video build cap; default 3.
VIDEO_BUILD_LIMIT_PER_CAMPAIGN=3

# QUALITY_LLM_JUDGE: Purpose optional quality judge; default off; allowed on/off.
QUALITY_LLM_JUDGE=off
# EXPORT_REQUIRES_APPROVAL: Purpose export gate; default true; allowed true/false.
EXPORT_REQUIRES_APPROVAL=true

# ENHANCE_HINDI: Purpose opt-in Hindi generation; default off; allowed off/on.
ENHANCE_HINDI=off
# ENHANCE_BRAND_KIT: Purpose opt-in campaign brand kits; default off; allowed off/on.
ENHANCE_BRAND_KIT=off
